        {
          "name": "POST 04. Bono Saio 1 Kontsumitu (Transakzioa)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:5089/api/bonoak/ane@goierri.eus/erabili",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5089",
              "path": ["api", "bonoak", "ane@goierri.eus", "erabili"]
            },
            "description": "Bonoaren saio 1 deskontatzen du FOR UPDATE blokeoarekin, saldo negatiboak ekiditeko."
          }
        },
        {
          "name": "POST 05. Erreserba Sortu (Transakzioa + Bono deskontua)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pistaId\": 1,\n  \"bazkideaId\": 1,\n  \"data\": \"2026-10-28\",\n  \"ordua\": \"18:00:00\",\n  \"erabiliBonoa\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5089/api/erreserbak",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5089",
              "path": ["api", "erreserbak"]
            },
            "description": "Erreserba berria txertatzen du transakzio atomiko batean: pista egiaztatu, bonoa deskontatu, hutsunea blokeatu (FOR UPDATE) eta UNIQUE murrizketa bermatu."
          }
        },
        {
          "name": "POST 06. Erreserba Sortu (Blokeo / Lock Simulazioarekin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pistaId\": 2,\n  \"bazkideaId\": 2,\n  \"data\": \"2026-10-28\",\n  \"ordua\": \"19:00:00\",\n  \"erabiliBonoa\": true,\n  \"itxaron\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:5089/api/erreserbak?itxaron=5000",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5089",
              "path": ["api", "erreserbak"],
              "query": [
                {
                  "key": "itxaron",
                  "value": "5000",
                  "description": "5 segundoko geldialdia simulatzen du transakzio barruan blokeoa probatzeko"
                }
              ]
            },
            "description": "Transakzioa irekita mantentzen du 5 segundoz aldi bereko beste eskaerek nola itxaroten duten (Lock wait) edo huts egiten duten frogatzeko."
          }
        }
      ]
