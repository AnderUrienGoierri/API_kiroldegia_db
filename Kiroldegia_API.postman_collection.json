    {
      "name": "2. POST Eskaerak (Sortzea & Transakzioak)",
      "description": "Datuak sortzeko eta transakzio seguruak (ACID / FOR UPDATE) burutzeko eskaerak.",
      "item": [
        {
          "name": "POST 01. Pista Berria Sortu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"izena\": \"Padel 2\",\n  \"kirola\": \"Padela\"\n}",
