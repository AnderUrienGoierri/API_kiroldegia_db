      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pistaId\": 1,\n  \"bazkideaId\": 1,\n  \"data\": \"2026-10-25\",\n  \"ordua\": \"18:00:00\",\n  \"erabiliBonoa\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5089/api/erreserbak",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5089",
          "path": ["api", "erreserbak"]
        },
        "description": "Erreserba berria txertatzen du transakzio atomiko batean (FOR UPDATE blokeoarekin eta bonoaren saio 1 kenduz)."
      }
    },
    {
      "name": "06. Erreserba Ezabatu (SOFT DELETE - Logikoa)",
      "request": {
        "method": "DELETE",
        "header": [],
